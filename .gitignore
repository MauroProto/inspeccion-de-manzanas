# macOS y editores
.DS_Store
._*
.idea/
.vscode/
*.swp

# Python y notebooks
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/
*.egg-info/
build/
dist/

# Claves y configuración privada
.env
.env.*
!.env.example
kaggle.json
credentials.json
token.json
*.pem
*.key

# Copias locales nuevas. Los datasets originales ya versionados siguen en Git.
/datos/originales/*
!/datos/originales/.gitkeep
/datos/preparados/*
!/datos/preparados/.gitkeep

# Videos generados y archivos comprimidos
*.mp4
*.mov
*.avi
*.mkv
*.webm
*.part
*.zip
*.tar
*.gz
*.7z

# Pesos y exportaciones de modelos
/pesos/*
!/pesos/.gitkeep
*.pt
*.pth
*.ckpt
*.onnx
*.engine

# Archivos de la entrega
!/pesos/
!/pesos/yolo_manzanas.pt
!/pesos/cnn_variedades.pt
!/pesos/cnn_danio_visible.pt
!/pesos/cnn_confirmacion_danio.pt
!/videos/*.mp4

# Salidas del entrenamiento
/runs/
/resultados/
/wandb/
*.log
